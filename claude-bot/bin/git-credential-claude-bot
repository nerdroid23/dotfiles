#!/usr/bin/env bash
# git credential helper that answers with a nerdroid-claude[bot] installation
# token for the repository owner. Requires credential.useHttpPath=true so git
# sends the path (OWNER/REPO...). Only `get` is handled.
set -uo pipefail

self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
BIN_DIR=$(cd "$(dirname "$self")" && pwd -P)

[ "${1:-}" = get ] || exit 0

protocol='' host='' path=''
while IFS= read -r line && [ -n "$line" ]; do
  case $line in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
    path=*) path=${line#path=} ;;
  esac
done

fail() {
  printf 'git-credential-claude-bot: %s\n' "$*" >&2
  printf 'quit=1\n'
  exit 0
}

case $host in
  github.com) ;;
  gist.github.com) fail "gists are not available to nerdroid-claude[bot] (GitHub App tokens cannot access gists); ask the user" ;;
  *) fail "unsupported host '$host'" ;;
esac
[ -n "$path" ] || fail "no repository path from git; set credential.useHttpPath=true for $protocol://$host"

owner=${path#/}
owner=${owner%%/*}
[ -n "$owner" ] || fail "cannot determine repository owner from path '$path'"

token=$("$BIN_DIR/claude-bot-token" "$owner") \
  || fail "could not get a nerdroid-claude[bot] token for $owner (see message above)"

printf 'protocol=%s\nhost=%s\nusername=x-access-token\npassword=%s\n' \
  "${protocol:-https}" "$host" "$token"
